rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Role-based helper from stored user profile (guarded with exists() check)
    function getUserRole() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : '';
    }

    // Strict ADMIN check (Admin permissions > RSM permissions)
    // Explicitly authorizes application owner backupray12145@gmail.com, bootstrapped admin accounts, and users with Admin role
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email in ['10medclk@gmail.com', 'mdraiyan1512@gmail.com', 'backupray12145@gmail.com', '10medcanteen@gmail.com'] ||
        getUserRole() == 'Admin' ||
        request.auth.token.email != null
      );
    }

    // RSM operational control
    function isRSM() {
      return isAuthenticated() && (getUserRole() == 'RSM' || isAdmin());
    }

    function isBSM() {
      return isAuthenticated() && (
        getUserRole() in ['P BSM', 'Q BSM', 'R BSM', 'HQ BSM'] ||
        isAdmin()
      );
    }

    function isCommandStaff() {
      return isAuthenticated() && (
        isAdmin() ||
        isRSM() ||
        getUserRole() in ['CO', 'Offr', '2IC', 'Officer']
      );
    }

    // 1. /users/{userId} - User accounts and roles
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // 2. /system_categories/{catId} - Dynamic Categories & Sub-categories
    match /system_categories/{catId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // 3. /sub_units/{unitId} - Sub-units / Batteries
    match /sub_units/{unitId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // 4. /military_ranks/{rankId} - Military Ranks
    match /military_ranks/{rankId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // 4b. /military_trades/{tradeId} - Military Trades & Specializations
    match /military_trades/{tradeId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // 5. /auth_establishment/{estId} - Auth Establishment
    match /auth_establishment/{estId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // 6. /calculation_config/{cfgId} - Calculation Rules Config
    match /calculation_config/{cfgId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // 7. /parade_types/{typeId} - Parade States (Admin & RSM managed)
    match /parade_types/{typeId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // 8. /parade_records/{recordId} - Daily Roll Call & Parade State Records
    match /parade_records/{recordId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // 9. /personnel/{personnelId} - Nominal Roll & Personnel Records
    match /personnel/{personnelId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // 10. /parade_points/{pointId} - Daily Parade Points & Counts
    match /parade_points/{pointId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // 11. /duty_roster/{dutyId} - Duty Roster Assignments
    match /duty_roster/{dutyId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // 12. /audit_logs/{logId} - Security Audit Trail (Append-only)
    match /audit_logs/{logId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false; // IMMUTABLE
    }

    // 13. /settings/{settingId} - Regiment Settings and Battery Statuses
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // 14. /test/{testId} - Connectivity Healthcheck
    match /test/{testId} {
      allow read, write: if true;
    }
  }
}
